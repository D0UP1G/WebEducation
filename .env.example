DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=1
# Local development defaults only. HTTPS profile forces DEBUG=0 and secure cookies.
# Replace secret, database password, host and CSRF origin before any public deployment.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgresql://webeducation:webeducation@db:5432/webeducation
POSTGRES_DB=webeducation
POSTGRES_USER=webeducation
POSTGRES_PASSWORD=webeducation
WEB_PORT=8000
PROXY_PORT=127.0.0.1:8080
MAX_UPLOAD_SIZE=10485760
# Keep this at or above MAX_UPLOAD_SIZE plus multipart overhead. 11m accepts
# a 10 MiB file while Django remains the exact validation boundary.
CLIENT_MAX_BODY_SIZE=11m
# Enable the HTTPS profile with docker-compose.https.yml after providing PEM files.
# HTTPS_PORT=443
# TLS_CERTIFICATE_FILE=/etc/letsencrypt/live/example/fullchain.pem
# TLS_CERTIFICATE_KEY_FILE=/etc/letsencrypt/live/example/privkey.pem
